# Copy these names into Render > Environment. Never commit real values.

# Claude API key. Without it the app works, but the tutor tab shows "not set up".
ANTHROPIC_API_KEY=

# Code people must type before they can use the tutor. Leave empty to let anyone use it (this spends your API credit).
ACCESS_CODE=

# Optional. Maximum tutor messages per day across all visitors. Default 150.
DAILY_TUTOR_CAP=

# Optional. Claude model used by the tutor. Default claude-haiku-5-5.
ANTHROPIC_MODEL=
